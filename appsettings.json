{
  "Jwt": {
    "Authority": "replace-with-real-auth-api-url-in-compose"
  },
  "ConnectionStrings": {
    "DefaultConnection": "replace-with-real-connection-string"
  },
  "Docker": {
    "SocketPath": "/var/run/docker.sock"
  },
  "Host": {
    "ProcPath": "/proc",
    "SysPath": "/host/sys",
    "EmhttpPath": "/host/emhttp",
    "NetworkInterfaces": [ "br0" ],
    "TemperatureLabels": [ "Package id 0", "Composite" ]
  },
  "FileIo": {
    "CountersPath": "/run/fileio/counters",
    "MaxAgeSeconds": 5
  },
  "DefaultHistoryRange": "1h",
  "MetricsCollectionIntervalMillis": 1000,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}