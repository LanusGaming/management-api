{
  "Jwt": {
    "Secret": "replace-with-real-secret-in-compose",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "replace-with-real-connection-string"
  },
  "Docker": {
    "SocketPath": "/var/run/docker.sock"
  },
  "DefaultHistoryRange": "1h",
  "MetricsCollectionIntervalSeconds": 5,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}