@host = http://localhost:5087

### Register a user (run this first)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "patrick",
  "password": "testpassword123"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "patrick",
  "password": "testpassword123"
}

### Refresh token
POST {{host}}/api/auth/refresh
Content-Type: application/json

